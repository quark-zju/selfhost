# HTTPS and authentication are provided by the existing reverse proxy.
DRAWSRV_LISTEN=127.0.0.1:8080
DRAWSRV_MAX_CANVAS_MIB=16
# Canvas LRU payload budget in MiB (also limited to 64 entries); 0 disables.
DRAWSRV_CACHE_MIB=4
# Delay from first dirty write; 0 disables daemon-coordinated foreground GC.
DRAWSRV_MAINTENANCE_DELAY=10m
# Go runtime soft target, not a hard cap for Go plus Git subprocesses.
GOMEMLIMIT=64MiB
